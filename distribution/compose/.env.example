COMPOSE_PROJECT_NAME=switchboard
SWITCHBOARD_PORT=8770
SWITCHBOARD_PUBLIC_URL=http://127.0.0.1:8770
SWITCHBOARD_IMAGE=ghcr.io/tader/switchboard:latest
SWITCHBOARD_UPDATER_IMAGE=ghcr.io/tader/switchboard-updater:latest
# Optional source-built installation (run from a source checkout):
SWITCHBOARD_SOURCE_BUILD=false
SWITCHBOARD_SOURCE_DIR=../..
# SWITCHBOARD_REVISION=<40-character source revision>
